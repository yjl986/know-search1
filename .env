# ============================================================
# KnowSearch 知识检索问答平台 配置（本文件不会被提交到版本库）
# 用法：填写下方大模型 API 三项后保存，重启 app.py 生效。
# ============================================================

# ---------- 大模型 API（OpenAI 兼容接口，任选一家填写）----------
# DeepSeek 示例：
OPENAI_API_KEY=sk-143fd8dd341e43379f7a5b43f79233c3
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 硅基流动 SiliconFlow 示例（注释掉上面三行，取消下面注释）：
# OPENAI_API_KEY=sk-你的密钥
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# Ollama 本地模型示例：
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# ---------- 嵌入模型（可选，默认已自动使用本地模型）----------
# 本地已下载：models/bge-small-zh-v1.5（离线可用，无需配置）
# 如需改用 HuggingFace 模型，取消下行注释：
# EMBED_MODEL=BAAI/bge-small-zh-v1.5
