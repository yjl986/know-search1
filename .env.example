# ============================================================
# KnowSearch 知识检索问答平台 配置文件
# 使用方法：复制本文件为 .env（保持与 app.py 同一目录），
# 填写 OPENAI_API_KEY 等参数后保存，重启 app.py 生效。
# ============================================================

# ---------- 大模型 API（OpenAI 兼容接口，任选一家填写）----------

# 示例 1：DeepSeek
OPENAI_API_KEY=sk-143fd8dd341e43379f7a5b43f79233c3
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 示例 2：硅基流动 SiliconFlow（注释掉上面三行，取消下面注释）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# 示例 3：Ollama 本地模型（先运行 ollama serve 并拉取模型）
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b

# 示例 4：vLLM 本地服务
# OPENAI_API_KEY=EMPTY
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_MODEL=your-model-name

# ---------- 嵌入模型 ----------
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DEVICE=cpu

# ---------- 向量数据库（本地持久化，无需额外部署）----------
CHROMA_DIR=chroma_db
COLLECTION_NAME=knowsearch_docs

# ---------- 检索与切片参数 ----------
TOP_K=5
PER_DOC_LIMIT=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
